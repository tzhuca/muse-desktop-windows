<Window x:Class="Muse.Desktop.RecoveryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Could not load Muse"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Icon="/Resources/Muse.ico">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Muse could not be reached."
                   FontSize="15"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap" />

        <TextBlock Grid.Row="1"
                   Margin="0,8,0,0"
                   Text="Check your internet connection, then try again."
                   TextWrapping="Wrap"
                   Foreground="#555555" />

        <StackPanel Grid.Row="2"
                    Margin="0,20,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="RetryButton"
                    Width="88"
                    Padding="10,4"
                    IsDefault="True"
                    Content="Retry"
                    Click="OnRetryClick" />
            <Button Width="88"
                    Margin="10,0,0,0"
                    Padding="10,4"
                    IsCancel="True"
                    Content="Close" />
        </StackPanel>
    </Grid>
</Window>
