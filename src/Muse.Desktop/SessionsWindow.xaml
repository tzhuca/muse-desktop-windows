<Window x:Class="Muse.Desktop.SessionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sessions"
        Width="640"
        Height="520"
        Background="#101117"
        Icon="/Resources/Muse.ico"
        WindowStartupLocation="CenterOwner">
    <Grid Background="#101117" Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Conversation list -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Conversations"
                       Foreground="#E0E0E0"
                       FontWeight="SemiBold"
                       FontSize="14"
                       Margin="0,0,0,8" />

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Margin="0,0,0,8">
                <Button x:Name="NewButton"
                        Content="New"
                        Padding="10,3"
                        Click="OnNewClick" />
                <Button x:Name="DeleteButton"
                        Content="Delete"
                        Padding="10,3"
                        Margin="8,0,0,0"
                        Click="OnDeleteClick" />
            </StackPanel>

            <ListBox x:Name="ConversationList"
                     Grid.Row="2"
                     Background="#1A1B22"
                     Foreground="#E0E0E0"
                     BorderBrush="#2A2B33"
                     SelectionChanged="OnConversationSelected" />
        </Grid>

        <!-- Messages -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="DetailTitle"
                       Grid.Row="0"
                       Text="Select a conversation"
                       Foreground="#E0E0E0"
                       FontWeight="SemiBold"
                       FontSize="14"
                       Margin="0,0,0,8" />

            <ListBox x:Name="MessageList"
                     Grid.Row="1"
                     Background="#1A1B22"
                     Foreground="#E0E0E0"
                     BorderBrush="#2A2B33"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" />

            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="RoleBox"
                          Grid.Column="0"
                          Width="80"
                          SelectedIndex="0"
                          Background="#1A1B22"
                          Foreground="#E0E0E0"
                          BorderBrush="#2A2B33">
                    <ComboBoxItem Content="user" />
                    <ComboBoxItem Content="assistant" />
                    <ComboBoxItem Content="system" />
                </ComboBox>

                <TextBox x:Name="InputBox"
                         Grid.Column="1"
                         Margin="8,0"
                         Background="#1A1B22"
                         Foreground="#E0E0E0"
                         BorderBrush="#2A2B33"
                         Padding="6,3"
                         KeyDown="OnInputKeyDown" />

                <Button x:Name="SendButton"
                        Grid.Column="2"
                        Content="Send"
                        Padding="12,3"
                        Click="OnSendClick" />
            </Grid>
        </Grid>
    </Grid>
</Window>
